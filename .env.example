# copy to .env.local for local dev, and set the same keys on the host
# (vercel → settings → environment variables, or railway → service →
# variables). never commit the real file.

# postgres connection string. neon (vercel → storage → neon), supabase or
# railway postgres all work; use the pooled url where there is one. without
# it the site builds from content/*.json and the studio stays offline.
# on railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# railway only: builds cannot reach the private network, so railway.json
# builds against this one. ${{Postgres.DATABASE_PUBLIC_URL}}
# DATABASE_PUBLIC_URL=

# the only email that may create the studio account (once, ever)
OWNER_EMAIL=

# resend.com → api keys. sends the studio sign-up / reset codes and the
# contact form. in local dev without it, emails print to the terminal.
RESEND_API_KEY=

# who emails come from. until you verify your domain in resend, leave this
# unset: resend's test sender only delivers to the address you signed up with
# MAIL_FROM=Prabhat Bhusal <hello@prabhatbhusal.com.np>

# where contact form messages go (defaults to OWNER_EMAIL)
# CONTACT_TO=
